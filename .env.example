DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fortune_tiger
PORT=3000
LOG_PRETTY=true
METRICS_BACKEND=prometheus
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_URL=http://127.0.0.1:4566/000000000000/wager-transactions.fifo
SQS_DEAD_LETTER_QUEUE_URL=http://127.0.0.1:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://127.0.0.1:4566/000000000000/wager-events.fifo
SQS_EVENTS_DEAD_LETTER_QUEUE_URL=http://127.0.0.1:4566/000000000000/wager-events-dlq.fifo
MONGODB_URL=mongodb://127.0.0.1:27017/fortune_tiger_audit
REDIS_URL=redis://127.0.0.1:6379

# Semantic search (MCP). The atlas-local profile bundles the mongot search engine, so
# $vectorSearch works only there, and Ollama provides the embeddings. The CI pipeline
# for main and staging starts both and runs search:seed + search:check on every run.
# Locally: docker compose --profile search up -d
VECTOR_SEARCH_ENABLED=false
SEARCH_MONGODB_URL=mongodb://127.0.0.1:27018/fortune_tiger_search?directConnection=true
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
MONGODB_EVENTS_COLLECTION=searchable_events
MONGODB_VECTOR_INDEX=events_vector_index
VECTOR_SEARCH_TOP_K=5
VECTOR_SEARCH_MAX_TEXT_LENGTH=4000

# Auth. Keep anonymous for a local run; switch to jwt with the Keycloak profile:
# docker compose --profile auth up -d
AUTH_MODE=anonymous
OIDC_ISSUER=http://127.0.0.1:8080/realms/fortune-tiger
OIDC_AUDIENCE=fortune-tiger-api
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/fortune-tiger/protocol/openid-connect/certs
