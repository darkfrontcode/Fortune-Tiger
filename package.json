{
  "name": "fortune-tiger",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "test:unit": "bun test",
    "test:int": "bun test --config=bunfig.int.toml",
    "migration:up": "bunx --bun mikro-orm migration:up --config ./mikro-orm.config.ts",
    "migration:down": "bunx --bun mikro-orm migration:down --config ./mikro-orm.config.ts",
    "migration:pending": "bunx --bun mikro-orm migration:pending --config ./mikro-orm.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1155.0",
    "@mikro-orm/core": "6.4.16",
    "@mikro-orm/migrations": "6.4.16",
    "@mikro-orm/postgresql": "6.4.16",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1"
  },
  "mikro-orm": {
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  },
  "devDependencies": {
    "@mikro-orm/cli": "6.4.16",
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.0"
  }
}
