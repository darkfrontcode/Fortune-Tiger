{
  "name": "fortune-tiger",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "test:unit": "bun test --path-ignore-patterns '**/persistence/**' --path-ignore-patterns '**/*.e2e.test.ts'",
    "test:int": "bun test --config=bunfig.int.toml",
    "test:e2e": "bun test --config=bunfig.e2e.toml --path-ignore-patterns '**/http-failure.filter.test.ts' --path-ignore-patterns '**/identity.test.ts' --path-ignore-patterns '**/ledger-query.test.ts' --path-ignore-patterns '**/wager-dto-mapper.test.ts' --path-ignore-patterns '**/wager-status.test.ts' --path-ignore-patterns '**/wallet-dto-mapper.test.ts'",
    "test:concurrency": "bun test --config=bunfig.int.toml src/infrastructure/persistence/tests/races.test.ts",
    "verify": "bun run scripts/verify.ts",
    "verify:full": "bun run scripts/verify.ts full",
    "demo": "bun run scripts/demo.ts",
    "migration:up": "bunx --bun mikro-orm migration:up --config ./mikro-orm.config.ts",
    "migration:down": "bunx --bun mikro-orm migration:down --config ./mikro-orm.config.ts",
    "migration:pending": "bunx --bun mikro-orm migration:pending --config ./mikro-orm.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1155.0",
    "@mikro-orm/core": "6.4.16",
    "@mikro-orm/migrations": "6.4.16",
    "@mikro-orm/postgresql": "6.4.16",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1"
  },
  "mikro-orm": {
    "configPaths": [
      "./mikro-orm.config.ts"
    ]
  },
  "devDependencies": {
    "@mikro-orm/cli": "6.4.16",
    "@nestjs/testing": "^12.2.0",
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "^5.9.0"
  }
}
